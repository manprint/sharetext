/* sharetext service worker — read-only offline shell.
 * Version is injected by the server template ({{.Version}}); changing it
 * forces a byte-diff, install, and activate-side eviction of stale caches.
 *
 * Route classification lives in /static/sw-routes.js so the same logic is
 * unit-testable from node:test without faking a service worker scope.
 */
const VERSION = "{{.Version}}";
// BUILD_ID is a content hash injected at server start. It changes whenever
// any embedded asset changes, so even repeated deploys of the same VERSION
// tag (typical in dev) get fresh cache buckets and old caches are evicted
// in `activate`. Combining VERSION and BUILD_ID makes the cache name
// human-debuggable AND auto-invalidating.
const BUILD_ID = "{{.BuildID}}";
const CACHE_KEY = VERSION + "-" + BUILD_ID;
const CACHE = {
  static:  "static-" + CACHE_KEY,
  shells:  "shells-" + CACHE_KEY,
  api:     "api-" + CACHE_KEY,
  files:   "files-" + CACHE_KEY,
};
const KNOWN_PREFIXES = ["static-", "shells-", "api-", "files-"];

const PRECACHE_URLS = [
  "/",
  "/static/style.css",
  "/static/app.js",
  "/static/blocks.js",
  "/static/linkify.js",
  "/static/countdown.js",
  "/static/download.js",
  "/static/files.js",
  "/static/sync.js",
  "/static/outbox.js",
  "/static/connection.js",
  "/static/editor.js",
  "/static/lock.js",
  "/static/commands.js",
  "/static/offline-guard.js",
  "/static/sw-routes.js",
  "/static/crypto.js",
  "/static/bundle-client.js",
  "/static/e2e-state.js",
  "/static/pinning.js",
  "/static/pin-launcher.js",
  "/static/create.js",
  "/static/favicon.svg",
  "/static/icon-maskable.svg",
  "/static/icon-192.png",
  "/static/icon-512.png",
  "/static/icon-180.png",
  "/static/manifest.webmanifest",
];

const FILES_CACHE_MAX = 30;

importScripts("/static/sw-routes.js");

self.addEventListener("install", (event) => {
  event.waitUntil((async () => {
    const cache = await caches.open(CACHE.static);
    // Best-effort: a missing optional asset (e.g. an icon not yet generated)
    // should not block the SW install. Pre-resolve each request and ignore
    // individual failures.
    await Promise.all(PRECACHE_URLS.map(async (url) => {
      try {
        const res = await fetch(url, { cache: "reload" });
        if (res && res.ok) await cache.put(url, res.clone());
      } catch {}
    }));
    await self.skipWaiting();
  })());
});

self.addEventListener("activate", (event) => {
  event.waitUntil((async () => {
    const keys = await caches.keys();
    const current = new Set(Object.values(CACHE));
    await Promise.all(keys.map((k) => {
      // Only touch caches we own (prefix match); leave anything else alone so
      // we never delete a cache another app in the origin scope might use.
      const owned = KNOWN_PREFIXES.some((p) => k.startsWith(p));
      if (owned && !current.has(k)) return caches.delete(k);
      return null;
    }));
    await self.clients.claim();
  })());
});

self.addEventListener("fetch", (event) => {
  const req = event.request;
  // sw-routes.js exports classifyRequest onto `self`.
  const kind = self.classifyRequest({ url: req.url, method: req.method });

  switch (kind) {
    case "bypass":
    case "passthrough":
      return; // let the browser handle it natively
    case "static-asset":
      event.respondWith(cacheFirst(req, CACHE.static));
      return;
    case "shell":
      event.respondWith(networkFirstShell(req, CACHE.shells));
      return;
    case "api-snapshot":
      event.respondWith(networkFirstSnapshot(req, CACHE.api));
      return;
    case "api-file-blob":
      event.respondWith(cacheFirstWithBound(req, CACHE.files, FILES_CACHE_MAX));
      return;
    default:
      return;
  }
});

async function cacheFirst(req, cacheName) {
  const cache = await caches.open(cacheName);
  const hit = await cache.match(req);
  if (hit) return hit;
  try {
    const res = await fetch(req);
    if (res && res.ok) cache.put(req, res.clone()).catch(() => {});
    return res;
  } catch (err) {
    // Last-resort match without query/vary normalization
    const fallback = await cache.match(req, { ignoreSearch: true });
    if (fallback) return fallback;
    throw err;
  }
}

async function networkFirstShell(req, cacheName) {
  const cache = await caches.open(cacheName);
  try {
    const res = await fetch(req);
    if (res && res.ok) {
      cache.put(req, res.clone()).catch(() => {});
    } else if (res && (res.status === 404 || res.status === 410)) {
      // Session gone: drop any cached shell so the next offline reload does
      // not resurrect a dead session URL.
      cache.delete(req).catch(() => {});
    }
    return res;
  } catch {
    const hit = await cache.match(req);
    if (hit) return hit;
    // Fallback: try the landing page so the user at least gets the app shell.
    const root = await cache.match("/");
    if (root) return root;
    return new Response("Offline", { status: 503, statusText: "Offline" });
  }
}

// Session snapshots are network-first: the app reads them to decide whether
// the session still exists (before every reconnect) and to seed the editor,
// so a cached copy is only good while the network is unusable. Serving it
// first would resurrect deleted sessions and keep the editor reconnecting to
// them forever. A network that hangs instead of failing is unusable too: once
// SNAPSHOT_TIMEOUT_MS have passed, a cached copy is served while the request
// carries on in the background to refresh it.
const SNAPSHOT_TIMEOUT_MS = 4000;

async function networkFirstSnapshot(req, cacheName) {
  const cache = await caches.open(cacheName);
  const network = fetch(req).then((res) => {
    if (res && res.ok) {
      cache.put(req, res.clone()).catch(() => {});
    } else if (res && (res.status === 404 || res.status === 410)) {
      cache.delete(req).catch(() => {});
    }
    return res;
  });
  network.catch(() => {});
  const cached = await cache.match(req);
  if (cached) {
    let timer;
    const timeout = new Promise((resolve) => { timer = setTimeout(resolve, SNAPSHOT_TIMEOUT_MS, null); });
    try {
      const res = await Promise.race([network, timeout]);
      if (res) return res;
    } catch {
      // network error: fall through to the cached copy
    } finally {
      clearTimeout(timer);
    }
    return cached;
  }
  try {
    return await network;
  } catch {
    return new Response(JSON.stringify({ error: "offline" }), {
      status: 503,
      headers: { "Content-Type": "application/json" },
    });
  }
}

async function cacheFirstWithBound(req, cacheName, max) {
  const cache = await caches.open(cacheName);
  const hit = await cache.match(req);
  if (hit) return hit;
  try {
    const res = await fetch(req);
    if (res && res.ok) {
      await cache.put(req, res.clone());
      await trimCache(cache, max);
    }
    return res;
  } catch (err) {
    throw err;
  }
}

async function trimCache(cache, max) {
  const keys = await cache.keys();
  if (keys.length <= max) return;
  // Cache.keys() preserves insertion order; evict the oldest until we are
  // back under the cap.
  const overflow = keys.length - max;
  await Promise.all(keys.slice(0, overflow).map((k) => cache.delete(k)));
}
